# ─── AEGIS Environment Variables ───────────────────────────────────────────────

# Session Secret (Random long string)
SESSION_SECRET="your-very-secret-session-key-change-me"

# VAPID Credentials for Web Push Notifications
# You can generate these at https://vapidkeys.com/ or use local tools
VAPID_PUBLIC_KEY="BIdFxxxxxxx..."
VAPID_PRIVATE_KEY="xxxxxxxxx..."
VAPID_EMAIL="admin@aegis.corp"

# BMKG API URL (Fetch digital data)
# Example Jakarta: https://data.bmkg.go.id/DataFE/peringatan-dini-cuaca.xml (CAP)
# For the refactored system, use the endpoint that returns JSON:
BMKG_API_URL="https://raw.githubusercontent.com/rizkynindra/bmkg-data-json/main/data.json"

# Database Configuration
# Local Development: sqlite:///./weather_app.db
# Production (Vercel/Neon): postgresql://user:pass@ep-flat-water-123.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite:///./weather_app.db"

# Cron Secret for /api/cron/weather-check
# Set this for security if using external cron services like cron-job.org or Vercel Cron
CRON_SECRET="your-custom-cron-password"

# Optional: BMKG CAP RSS URL
BMKG_RSS_URL="https://data.bmkg.go.id/DataFE/peringatan-dini-cuaca.xml"
