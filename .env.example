# AEGIS - Vercel & PostgreSQL Deployment Template
# INSTRUCTIONS: 
# 1. Copy this file and rename it to .env
# 2. NEVER commit your .env file to version control (GitHub)

# ─── Database (PostgreSQL) ──────────────────────────────────
# Get your connection string from Neon (https://neon.tech)
# Example: postgresql://user:pass@ep-hostname.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_postgresql_connection_string_here

# ─── Security & Sessions ────────────────────────────────────
# Generate a random 32-character string
# Tip: Use `openssl rand -base64 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=your_random_session_secret_here

# ─── Cron Security ──────────────────────────────────────────
# Set a secret key to protect your /api/cron/weather-check endpoint
# Add this as a query param in cron-job.org: ?secret=YOUR_CRON_SECRET
CRON_SECRET=your_random_cron_token_here

# ─── Web Push Notifications (VAPID) ─────────────────────────
# Generate these keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_starting_with_B
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=admin@your-office-domain.com

# ─── Weather Data ───────────────────────────────────────────
# Current office location ID (Bali / Denpasar Area)
BMKG_API_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca?adm4=51.71.04.1007
