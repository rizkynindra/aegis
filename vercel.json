{
  "framework": "fastapi",
  "name": "aegis-disaster-system",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/weather-check",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weather-check",
      "schedule": "0 * * * *"
    }
  ]
}
